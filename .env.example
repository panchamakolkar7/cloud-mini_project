# QuotaCloud Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=quotacloud_secure_secret_key_change_in_production_2026
PORT=5000
HOST=127.0.0.1

# Database Configuration
DATABASE_URL=sqlite:///quotacloud.db

# Storage Backend Mode: 'local' or 'hdfs'
STORAGE_BACKEND=local

# Local Storage Directory (absolute or relative to project root, outside public static)
LOCAL_STORAGE_DIR=storage/data

# Hadoop HDFS Configuration (used when STORAGE_BACKEND=hdfs)
# Default WebHDFS NameNode URL (Hadoop 3.x default is 9870, Hadoop 2.x is 50070)
HDFS_NAMENODE_URL=http://localhost:9870
HDFS_USER=hadoop
HDFS_ROOT_DIR=/quotacloud/users
# Optional timeout in seconds for HDFS requests
HDFS_TIMEOUT=5

# Quota Defaults (in Megabytes: 51200 MB = 50 GB)
DEFAULT_USER_QUOTA_MB=51200
STORAGE_WARNING_THRESHOLD_PERCENT=80
SYSTEM_STORAGE_CAPACITY_MB=512000

# Maximum single upload size limit in Megabytes (5120 MB = 5 GB)
MAX_CONTENT_LENGTH_MB=5120
